[Unit]
Description=srdq web proxy (exposes srdq-web on the ECS private address; disabled by default)
Wants=network-online.target srdq-web.service
After=network-online.target srdq-web.service

[Service]
Type=simple
DynamicUser=yes
# Holds SRDQ_PROXY_LISTEN / SRDQ_PROXY_AUTH / SRDQ_PROXY_USERS; root:root 0600, read by systemd before dropping privileges.
EnvironmentFile=/etc/srdq/web-proxy.env
ExecStart=/opt/srdq/current/venv/bin/python /opt/srdq/bin/srdq-web-proxy
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
InaccessiblePaths=-/etc/srdq -/var/lib/srdq -/run/srdq-pg
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
# Client networks and the ECS's own private IP/32 go in srdq-web-proxy.service.d/allow.conf (appended to this list).
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
