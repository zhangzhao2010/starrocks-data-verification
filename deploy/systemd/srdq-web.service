[Unit]
Description=srdq web dashboard and REST API (127.0.0.1:8470, reach it through an SSH tunnel)
Requires=srdq-pg.service
After=network-online.target srdq-pg.service srdq-controller.service
Wants=srdq-controller.service

[Service]
Type=simple
User=srdq-ctl
Group=srdq
SupplementaryGroups=srdq-pg
Environment=SRDQ_CONFIG=/etc/srdq/config.yaml
ExecStart=/opt/srdq/current/venv/bin/srdq web
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/srdq/reports
InaccessiblePaths=-/etc/srdq/secrets/huawei.json -/etc/srdq/secrets/aliyun.json
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
